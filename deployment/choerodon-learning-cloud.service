[Unit]
Description=Choerodon Learning Lab (isolated browser visitors)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=choerodon-lab
Group=choerodon-lab
WorkingDirectory=/opt/choerodon-learning-lab/releases/20260927-browser-users
Environment=PATH=/opt/choerodon-tooling/node-v20.18.0-linux-x64/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=PORT=3421
Environment=LEARN_ORIGIN=https://zhchoice.xyz
Environment=LEARN_DATA_DIR=/opt/choerodon-learning-lab/visitor-data
Environment=LEARN_SECRET_FILE=/opt/choerodon-learning-lab/visitor-identity.key
Environment=NODE_OPTIONS=--max-old-space-size=384
ExecStart=/opt/choerodon-tooling/node-v20.18.0-linux-x64/bin/node deployment/cloud-server.js
Restart=on-failure
RestartSec=10
UMask=0077
MemoryMax=600M
CPUQuota=100%
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/opt/choerodon-learning-lab/visitor-data

[Install]
WantedBy=multi-user.target
